# ============================================================
# INSTRUÇÕES: Como obter as API Keys FREE
# ============================================================

# -------------------------------------------------------------
# 1. COHERE (Embeddings) - FREE: 1000 calls/min
# -------------------------------------------------------------
# URL: https://dashboard.cohere.com/
# 1. Criar conta (pode usar Google/GitHub)
# 2. Dashboard → API Keys
# 3. Create API Key → Trial Key (free tier)
# 4. Copiar a key que começa com algo como: abc123xyz...
# 5. Colar abaixo em COHERE_API_KEY

# -------------------------------------------------------------
# 2. GROQ (LLM RAG) - FREE: 30 req/min, 14.4K tokens/min
# -------------------------------------------------------------
# URL: https://console.groq.com/
# 1. Criar conta (email ou Google)
# 2. Dashboard → API Keys
# 3. Create API Key
# 4. Copiar a key (começa com: gsk_...)
# 5. Colar abaixo em GROQ_API_KEY

# -------------------------------------------------------------
# 3. MISTRAL (LLM Backup + OCR) - FREE: 1M tokens/mês
# -------------------------------------------------------------
# URL: https://console.mistral.ai/
# 1. Criar conta
# 2. API Keys → Create new key
# 3. Selecionar "Free tier"
# 4. Copiar a key
# 5. Colar abaixo em MISTRAL_API_KEY

# -------------------------------------------------------------
# IMPORTANTE: Depois de preencher, salvar como .env
# -------------------------------------------------------------
# 1. Preencher as 3 keys abaixo
# 2. Salvar este arquivo como: .env (remover .INSTRUCOES)
# 3. Ou copiar para o .env existente

# ============================================================
# CONFIGURAÇÃO
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=infoimoveis2024
POSTGRES_DB=infoimoveis
POSTGRES_USER=postgres

# n8n
N8N_USER=admin
N8N_PASSWORD=infoimoveis2024

# APIs Free Tier
COHERE_API_KEY=COLE_SUA_KEY_COHERE_AQUI
GROQ_API_KEY=COLE_SUA_KEY_GROQ_AQUI
MISTRAL_API_KEY=COLE_SUA_KEY_MISTRAL_AQUI
OPENROUTER_API_KEY=optional_se_quiser_backup

# Ollama (local) - Opcional se instalar Ollama
OLLAMA_HOST=http://localhost:11434
